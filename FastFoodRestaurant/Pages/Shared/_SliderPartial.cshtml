@model FastFoodRestaurant.Pages.Menu.IndexModel

<section class="slider_section ">
    <div id="customCarousel1" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < 3; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="container">
                        <h1>@Model.Food[i].Name</h1>
                        <p>@Model.Food[i].Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

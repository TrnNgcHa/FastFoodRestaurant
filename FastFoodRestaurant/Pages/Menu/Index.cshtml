@page
@model FastFoodRestaurant.Pages.Menu.IndexModel

@{
    ViewData["Title"] = "Thực đơn";
}


<header class="header_section" style="background-color: dimgray">
    <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
            <a class="navbar-brand" asp-area="" asp-page="/Index">
                <span>
                    DDH
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class=""> </span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav  mx-auto ">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index"><i class="bi bi-house">Trang chủ</i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Menu/Index"><i class="bi bi-fork-knife">Thực đơn</i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Privacy">Điều khoản</a>
                    </li>
                </ul>
                <div class="user_option">
                    <a href="" class="user_link">
                        <i class="fa fa-user" aria-hidden="true"></i>
                    </a>
                    <a class="cart_link nav-link " style="color:white">
                        <i class="bi bi-cart-fill"></i>
                    </a>
                    <form class="form-inline">
                        <button class="btn  my-2 my-sm-0 nav_search-btn" type="submit">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </form>
                    <a href="" class="order_online">
                        Đặt hàng online
                    </a>
                </div>
            </div>
        </nav>
    </div>
</header>

<!-- food section -->

<section class="food_section layout_padding">
    <div class="container">

        <div class="heading_container heading_center">
            <h2>
                Thực đơn
            </h2>
        </div>

        <ul class="filters_menu" role="tablist">
            <li class="active" data-filter="*" role="tab" tabindex="0">All</li>
            <li data-filter=".Burger" role="tab" tabindex="0">Burger</li>
            <li data-filter=".Pizza" role="tab" tabindex="0">Pizza</li>
            <li data-filter=".Extra" role="tab" tabindex="0">Đồ ăn kèm</li>
            <li data-filter=".Drinks" role="tab" tabindex="0">Thức uống</li>
        </ul>

        <div class="filters-content">
            <div class="row grid">
                @foreach (var item in Model.Food){
                    <div class="col-sm-6 col-lg-4 all @(item.Category)">
                        <div class="box">
                            <div>
                                <div class="img-box">
                                    <img src="@item.ImageURL" style="width: 100%; height: auto; object-fit: cover;">
                                </div>
                                <div class="detail-box">
                                    <h5>
                                        @item.Name
                                    </h5>
                                    <p>
                                        @item.Description
                                    </p>
                                    <div class="options">
                                        <h6>
                                            @Html.DisplayFor(modelItem => item.Price)
                                        </h6>
                                        <a asp-page="./Order" asp-route-id="@item.Id">
                                            <i class="bi bi-cart-fill"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i></a> |
                                        <a asp-page="./Details" asp-route-id="@item.Id"><i class="bi bi-info-circle"></i></a> |
                                        <a asp-page="./Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                
            </div>
            
        </div>
        <script src="~/style/js/menu-filter.js" asp-append-version="true"></script>
        <div class="btn-box">
            <a asp-page="Create">Tạo thêm</a>
        </div>
    </div>
</section>

<!-- end food section -->

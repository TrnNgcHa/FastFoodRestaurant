@page
@model FastFoodRestaurant.Pages.Menu.OrderHistoryModel
@{
    ViewData["Title"] = "Lịch sử đặt hàng";
}

<div class="container mt-4">
    <h2 class="mb-4">Danh sách đơn hàng đã đặt</h2>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn</th>
                <th>Tên khách hàng</th>
                <th>Số điện thoại</th>
                <th>Ngày đặt</th>
                <th>Số lượng</th>
                <th>Tổng tiền</th>
                <th>Địa chỉ</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Orders != null && Model.Orders.Any())
            {
                foreach (var item in Model.Orders)
                {
                    <tr>
                        <td>#@item.Id</td>
                        <td>@item.CustomerName</td>
                        <td>@item.Phone</td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Quantity</td>
                        <td class="text-danger fw-bold">@item.TotalPrice.ToString("N0") VNĐ</td>
                        <td>@item.Address</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">Chưa có đơn hàng nào được tạo.</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-page="./Index" class="btn btn-secondary">Quay lại thực đơn</a>
</div>